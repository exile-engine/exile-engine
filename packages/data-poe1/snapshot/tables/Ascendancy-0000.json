[{"key":"Juggernaut","rowIndex":0,"fields":{"Id":"Juggernaut","ClassNo":1,"Character":{"kind":"ref","table":"Characters","key":"Metadata/Characters/Str/Str","rowIndex":0},"CoordinateRect":"215,165,1063,436","RGBFlavourTextColour":"175,90,50","Name":"Juggernaut","FlavourText":"     What divides the conqueror \r\n from the conquered? Perseverance.","OGGFile":"Audio/Dialogue/NPC/Izaro/Iz_18_AscClass_01_Marauder_01_Juggernaught.ogg","PassiveTreeImage":"Art/2DArt/BaseClassIllustrations/JuggernaughtAscendency.dds","@unknown:9":-1736,"@unknown:10":-1550,"BackgroundImage":"Art/2DArt/UIImages/InGame/Classes/Str/Juggernaut/PassiveSkillScreenBackground","LeagueName":"Ancestral Commander","LeagueFlavourText":"     Thus spoke Kahutoroa.","LeagueBackgroundImage":"Art/2DArt/UIImages/InGame/Classes/CustomAscendancy/PassiveSkillScreenBackground","LeaguePassiveTreeImage":"Art/2DArt/BaseClassIllustrations/Str.dds","@unknown:16":0,"@unknown:17":0,"LeagueIcon":"Art/2DArt/UIImages/Common/IconStrAscendancy1","@unknown:19":false}},{"key":"Berserker","rowIndex":1,"fields":{"Id":"Berserker","ClassNo":2,"Character":{"kind":"ref","table":"Characters","key":"Metadata/Characters/Str/Str","rowIndex":0},"CoordinateRect":"760,345,976,429","RGBFlavourTextColour":"175,90,50","Name":"Berserker","FlavourText":"The savage path is \r\nalways swift and sure.","OGGFile":"Audio/Dialogue/NPC/Izaro/Iz_18_AscClass_01_Marauder_02_Berserker.ogg","PassiveTreeImage":"Art/2DArt/BaseClassIllustrations/BeserkerAscendency.dds","@unknown:9":-1736,"@unknown:10":-1550,"BackgroundImage":"Art/2DArt/UIImages/InGame/Classes/Str/Berserker/PassiveSkillScreenBackground","LeagueName":"Behemoth","LeagueFlavourText":"Ramping does not\r\nmean to run\r\naway in fear.","LeagueBackgroundImage":"Art/2DArt/UIImages/InGame/Classes/CustomAscendancy/PassiveSkillScreenBackground","LeaguePassiveTreeImage":"Art/2DArt/BaseClassIllustrations/Str.dds","@unknown:16":0,"@unknown:17":0,"LeagueIcon":"Art/2DArt/UIImages/Common/IconStrAscendancy2","@unknown:19":false}},{"key":"Chieftain","rowIndex":2,"fields":{"Id":"Chieftain","ClassNo":3,"Character":{"kind":"ref","table":"Characters","key":"Metadata/Characters/Str/Str","rowIndex":0},"CoordinateRect":"185,245,1076,449","RGBFlavourTextColour":"175,90,50","Name":"Chieftain","FlavourText":"   The Ancestors speak \r\nthrough your clenched fists.","OGGFile":"Audio/Dialogue/NPC/Izaro/Iz_18_AscClass_01_Marauder_03_Chieftain.ogg","PassiveTreeImage":"Art/2DArt/BaseClassIllustrations/ChieftainAscendency.dds","@unknown:9":-1786,"@unknown:10":-1350,"BackgroundImage":"Art/2DArt/UIImages/InGame/Classes/Str/Chieftain/PassiveSkillScreenBackground","LeagueName":"Antiquarian","LeagueFlavourText":"   History must be preserved \r\nnot just of our ancestors.","LeagueBackgroundImage":"Art/2DArt/UIImages/InGame/Classes/CustomAscendancy/PassiveSkillScreenBackground","LeaguePassiveTreeImage":"Art/2DArt/BaseClassIllustrations/Str.dds","@unknown:16":0,"@unknown:17":0,"LeagueIcon":"Art/2DArt/UIImages/Common/IconStrAscendancy3","@unknown:19":false}},{"key":"Raider","rowIndex":3,"fields":{"Id":"Raider","ClassNo":1,"Character":{"kind":"ref","table":"Characters","key":"Metadata/Characters/Dex/Dex","rowIndex":3},"CoordinateRect":"365,965,900,1250","RGBFlavourTextColour":"124,179,118","Name":"Warden","FlavourText":"A sacred duty. An ancestral promise.\r\nDeliver the fury of the wilds and\r\ntear evil asunder.","OGGFile":"Audio/Dialogue/NPC/Izaro/Iz_18_AscClass_03_Ranger_01_Raider.ogg","PassiveTreeImage":"Art/2DArt/BaseClassIllustrations/RaiderAscendency.dds","@unknown:9":-1650,"@unknown:10":-2155,"BackgroundImage":"Art/2DArt/UIImages/InGame/Classes/Dex/Raider/PassiveSkillScreenBackground","LeagueName":"Wildspeaker","LeagueFlavourText":"The First Ones exist,\r\nI have seen them in the\r\nforest of the night.","LeagueBackgroundImage":"Art/2DArt/UIImages/InGame/Classes/CustomAscendancy/PassiveSkillScreenBackground","LeaguePassiveTreeImage":"Art/2DArt/BaseClassIllustrations/Dex.dds","@unknown:16":0,"@unknown:17":0,"LeagueIcon":"Art/2DArt/UIImages/Common/IconDexAscendancy1","@unknown:19":false}},{"key":"Deadeye","rowIndex":4,"fields":{"Id":"Deadeye","ClassNo":2,"Character":{"kind":"ref","table":"Characters","key":"Metadata/Characters/Dex/Dex","rowIndex":3},"CoordinateRect":"335,1045,870,1330","RGBFlavourTextColour":"124,179,118","Name":"Deadeye","FlavourText":"A woman can change the world \r\nwith a single well-placed arrow.","OGGFile":"Audio/Dialogue/NPC/Izaro/Iz_18_AscClass_03_Ranger_02_Deadeye.ogg","PassiveTreeImage":"Art/2DArt/BaseClassIllustrations/DeadeyeAscendency.dds","@unknown:9":-1250,"@unknown:10":-1955,"BackgroundImage":"Art/2DArt/UIImages/InGame/Classes/Dex/Deadeye/PassiveSkillScreenBackground","LeagueName":"Whisperer","LeagueFlavourText":"it all feels wrong\r\nno I don't belong here","LeagueBackgroundImage":"Art/2DArt/UIImages/InGame/Classes/CustomAscendancy/PassiveSkillScreenBackground","LeaguePassiveTreeImage":"Art/2DArt/BaseClassIllustrations/Dex.dds","@unknown:16":0,"@unknown:17":0,"LeagueIcon":"Art/2DArt/UIImages/Common/IconDexAscendancy2","@unknown:19":false}},{"key":"Pathfinder","rowIndex":5,"fields":{"Id":"Pathfinder","ClassNo":3,"Character":{"kind":"ref","table":"Characters","key":"Metadata/Characters/Dex/Dex","rowIndex":3},"CoordinateRect":"265,975,900,1250","RGBFlavourTextColour":"124,179,118","Name":"Pathfinder","FlavourText":"There are venoms and virtues aplenty in \r\n the wilds, if you know where to look.","OGGFile":"Audio/Dialogue/NPC/Izaro/Iz_18_AscClass_03_Ranger_03_Pathfinder.ogg","PassiveTreeImage":"Art/2DArt/BaseClassIllustrations/PathfinderAscendency.dds","@unknown:9":-1250,"@unknown:10":-1855,"BackgroundImage":"Art/2DArt/UIImages/InGame/Classes/Dex/Pathfinder/PassiveSkillScreenBackground","LeagueName":"Daughter of Oshabi","LeagueFlavourText":"Once the Wildwood is purified\r\nnature will bloom again.","LeagueBackgroundImage":"Art/2DArt/UIImages/InGame/Classes/CustomAscendancy/PassiveSkillScreenBackground","LeaguePassiveTreeImage":"Art/2DArt/BaseClassIllustrations/Dex.dds","@unknown:16":0,"@unknown:17":0,"LeagueIcon":"Art/2DArt/UIImages/Common/IconDexAscendancy3","@unknown:19":false}},{"key":"Occultist","rowIndex":6,"fields":{"Id":"Occultist","ClassNo":1,"Character":{"kind":"ref","table":"Characters","key":"Metadata/Characters/Int/Int","rowIndex":1},"CoordinateRect":"665,385,906,389","RGBFlavourTextColour":"154,195,201","Name":"Occultist","FlavourText":" Throw off the chains\r\nof fear and embrace that\r\n which was forbidden.","OGGFile":"Audio/Dialogue/NPC/Izaro/Iz_18_AscClass_05_Witch_01_Occultist.ogg","PassiveTreeImage":"Art/2DArt/BaseClassIllustrations/OccultistAscendency.dds","@unknown:9":-2090,"@unknown:10":-701,"BackgroundImage":"Art/2DArt/UIImages/InGame/Classes/Int/Occultist/PassiveSkillScreenBackground","LeagueName":"Harbinger","LeagueFlavourText":"<<HBGAh>><<HBG01>><<HBGAe>><<HBG00>><<HBGAi>>\r\n<<HBGAa>><<HBG02>><<HBGAj>><<HBGAk>>","LeagueBackgroundImage":"Art/2DArt/UIImages/InGame/Classes/CustomAscendancy/PassiveSkillScreenBackground","LeaguePassiveTreeImage":"Art/2DArt/BaseClassIllustrations/Int.dds","@unknown:16":0,"@unknown:17":0,"LeagueIcon":"Art/2DArt/UIImages/Common/IconIntAscendancy1","@unknown:19":false}},{"key":"Elementalist","rowIndex":7,"fields":{"Id":"Elementalist","ClassNo":2,"Character":{"kind":"ref","table":"Characters","key":"Metadata/Characters/Int/Int","rowIndex":1},"CoordinateRect":"125,475,510,768","RGBFlavourTextColour":"154,195,201","Name":"Elementalist","FlavourText":"Feed a storm with savage intent \r\nand not even the strongest walls\r\nwill hold it back.","OGGFile":"Audio/Dialogue/NPC/Izaro/Iz_18_AscClass_05_Witch_02_Elementalist.ogg","PassiveTreeImage":"Art/2DArt/BaseClassIllustrations/ElementalistAscendency.dds","@unknown:9":-2232,"@unknown:10":-669,"BackgroundImage":"Art/2DArt/UIImages/InGame/Classes/Int/Elementalist/PassiveSkillScreenBackground","LeagueName":"Herald","LeagueFlavourText":"The end of all things is inevitable.\r\nIt is sooner than you think.","LeagueBackgroundImage":"Art/2DArt/UIImages/InGame/Classes/CustomAscendancy/PassiveSkillScreenBackground","LeaguePassiveTreeImage":"Art/2DArt/BaseClassIllustrations/Int.dds","@unknown:16":0,"@unknown:17":0,"LeagueIcon":"Art/2DArt/UIImages/Common/IconIntAscendancy2","@unknown:19":false}},{"key":"Necromancer","rowIndex":8,"fields":{"Id":"Necromancer","ClassNo":3,"Character":{"kind":"ref","table":"Characters","key":"Metadata/Characters/Int/Int","rowIndex":1},"CoordinateRect":"720,303,1000,1000","RGBFlavourTextColour":"154,195,201","Name":"Necromancer","FlavourText":"Embrace the serene\r\npower that is undeath.","OGGFile":"Audio/Dialogue/NPC/Izaro/Iz_18_AscClass_05_Witch_03_Necromancer.ogg","PassiveTreeImage":"Art/2DArt/BaseClassIllustrations/NecromancerAscendency.dds","@unknown:9":-2032,"@unknown:10":-469,"BackgroundImage":"Art/2DArt/UIImages/InGame/Classes/Int/Necromancer/PassiveSkillScreenBackground","LeagueName":"Bog Shaman","LeagueFlavourText":"Ingesting poisons\r\nbuilds character.","LeagueBackgroundImage":"Art/2DArt/UIImages/InGame/Classes/CustomAscendancy/PassiveSkillScreenBackground","LeaguePassiveTreeImage":"Art/2DArt/BaseClassIllustrations/Int.dds","@unknown:16":0,"@unknown:17":0,"LeagueIcon":"Art/2DArt/UIImages/Common/IconIntAscendancy3","@unknown:19":false}},{"key":"Slayer","rowIndex":9,"fields":{"Id":"Slayer","ClassNo":1,"Character":{"kind":"ref","table":"Characters","key":"Metadata/Characters/StrDex/StrDex","rowIndex":4},"CoordinateRect":"470,310,976,429","RGBFlavourTextColour":"150,175,200","Name":"Slayer","FlavourText":" No judge. No jury.\r\nJust the executioner.","OGGFile":"Audio/Dialogue/NPC/Izaro/Iz_18_AscClass_02_Duelist_01_Slayer.ogg","PassiveTreeImage":"Art/2DArt/BaseClassIllustrations/SlayerAscendency.dds","@unknown:9":-1959,"@unknown:10":-1432,"BackgroundImage":"Art/2DArt/UIImages/InGame/Classes/StrDex/Slayer/PassiveSkillScreenBackground","LeagueName":"Aristocrat","LeagueFlavourText":"Stop thinking that\r\nlife is fair.\r\nIt is not.","LeagueBackgroundImage":"Art/2DArt/UIImages/InGame/Classes/CustomAscendancy/PassiveSkillScreenBackground","LeaguePassiveTreeImage":"Art/2DArt/BaseClassIllustrations/StrDex.dds","@unknown:16":0,"@unknown:17":0,"LeagueIcon":"Art/2DArt/UIImages/Common/IconStrDexAscendancy1","@unknown:19":false}},{"key":"Gladiator","rowIndex":10,"fields":{"Id":"Gladiator","ClassNo":2,"Character":{"kind":"ref","table":"Characters","key":"Metadata/Characters/StrDex/StrDex","rowIndex":4},"CoordinateRect":"670,395,976,429","RGBFlavourTextColour":"150,175,200","Name":"Gladiator","FlavourText":"Raise your hand to the \r\nroaring crowd and pledge \r\nyour allegiance to glory.","OGGFile":"Audio/Dialogue/NPC/Izaro/Iz_18_AscClass_02_Duelist_02_Gladiator.ogg","PassiveTreeImage":"Art/2DArt/BaseClassIllustrations/GladiatorAscendency.dds","@unknown:9":-1359,"@unknown:10":-1632,"BackgroundImage":"Art/2DArt/UIImages/InGame/Classes/StrDex/Gladiator/PassiveSkillScreenBackground","LeagueName":"Gambler","LeagueFlavourText":"Life is more enjoyable when\r\nthe outcome is unexpected.","LeagueBackgroundImage":"Art/2DArt/UIImages/InGame/Classes/CustomAscendancy/PassiveSkillScreenBackground","LeaguePassiveTreeImage":"Art/2DArt/BaseClassIllustrations/StrDex.dds","@unknown:16":0,"@unknown:17":0,"LeagueIcon":"Art/2DArt/UIImages/Common/IconStrDexAscendancy2","@unknown:19":false}},{"key":"Champion","rowIndex":11,"fields":{"Id":"Champion","ClassNo":3,"Character":{"kind":"ref","table":"Characters","key":"Metadata/Characters/StrDex/StrDex","rowIndex":4},"CoordinateRect":"735,625,976,429","RGBFlavourTextColour":"150,175,200","Name":"Champion","FlavourText":"Champion that which \r\n you love. He who fights\r\n for nothing, dies\r\n for nothing.","OGGFile":"Audio/Dialogue/NPC/Izaro/Iz_18_AscClass_02_Duelist_03_Champion.ogg","PassiveTreeImage":"Art/2DArt/BaseClassIllustrations/ChampionAscendency.dds","@unknown:9":-1559,"@unknown:10":-1732,"BackgroundImage":"Art/2DArt/UIImages/InGame/Classes/StrDex/Champion/PassiveSkillScreenBackground","LeagueName":"Paladin","LeagueFlavourText":"Faith has taught me it\r\nis righteous to protect\r\nothers ahead of oneself.","LeagueBackgroundImage":"Art/2DArt/UIImages/InGame/Classes/CustomAscendancy/PassiveSkillScreenBackground","LeaguePassiveTreeImage":"Art/2DArt/BaseClassIllustrations/StrDex.dds","@unknown:16":0,"@unknown:17":0,"LeagueIcon":"Art/2DArt/UIImages/Common/IconStrDexAscendancy3","@unknown:19":false}},{"key":"Inquisitor","rowIndex":12,"fields":{"Id":"Inquisitor","ClassNo":1,"Character":{"kind":"ref","table":"Characters","key":"Metadata/Characters/StrInt/StrInt","rowIndex":6},"CoordinateRect":"285,940,926,429","RGBFlavourTextColour":"207,189,138","Name":"Inquisitor","FlavourText":" Truth is elusive, yet God has\r\nprovided us with all the tools \r\n necessary to find it.","OGGFile":"Audio/Dialogue/NPC/Izaro/Iz_18_AscClass_06_Templar_01_Inquisitor.ogg","PassiveTreeImage":"Art/2DArt/BaseClassIllustrations/InquisitorAscendency.dds","@unknown:9":-1318,"@unknown:10":-1781,"BackgroundImage":"Art/2DArt/UIImages/InGame/Classes/StrInt/Inquisitor/PassiveSkillScreenBackground","LeagueName":"Architect of Chaos","LeagueFlavourText":"The era of Order and its\r\nconsequences have been\r\na disaster for mortals.","LeagueBackgroundImage":"Art/2DArt/UIImages/InGame/Classes/CustomAscendancy/PassiveSkillScreenBackground","LeaguePassiveTreeImage":"Art/2DArt/BaseClassIllustrations/StrInt.dds","@unknown:16":0,"@unknown:17":0,"LeagueIcon":"Art/2DArt/UIImages/Common/IconStrIntAscendancy1","@unknown:19":false}},{"key":"Hierophant","rowIndex":13,"fields":{"Id":"Hierophant","ClassNo":2,"Character":{"kind":"ref","table":"Characters","key":"Metadata/Characters/StrInt/StrInt","rowIndex":6},"CoordinateRect":"100,720,936,399","RGBFlavourTextColour":"207,189,138","Name":"Hierophant","FlavourText":"Drink deeply from God's\r\n chalice, for the faithful\r\n will never find it empty.","OGGFile":"Audio/Dialogue/NPC/Izaro/Iz_18_AscClass_06_Templar_02_Hierophant.ogg","PassiveTreeImage":"Art/2DArt/BaseClassIllustrations/HierophantAscendency.dds","@unknown:9":-1418,"@unknown:10":-1781,"BackgroundImage":"Art/2DArt/UIImages/InGame/Classes/StrInt/Hierophant/PassiveSkillScreenBackground","LeagueName":"Puppeteer","LeagueFlavourText":"Who says life\r\nends at death?","LeagueBackgroundImage":"Art/2DArt/UIImages/InGame/Classes/CustomAscendancy/PassiveSkillScreenBackground","LeaguePassiveTreeImage":"Art/2DArt/BaseClassIllustrations/StrInt.dds","@unknown:16":0,"@unknown:17":0,"LeagueIcon":"Art/2DArt/UIImages/Common/IconStrIntAscendancy2","@unknown:19":false}},{"key":"Guardian","rowIndex":14,"fields":{"Id":"Guardian","ClassNo":3,"Character":{"kind":"ref","table":"Characters","key":"Metadata/Characters/StrInt/StrInt","rowIndex":6},"CoordinateRect":"170,780,976,429","RGBFlavourTextColour":"207,189,138","Name":"Guardian","FlavourText":"When bound by faith\r\n and respect, the flock\r\n will overwhelm the wolf.","OGGFile":"Audio/Dialogue/NPC/Izaro/Iz_18_AscClass_06_Templar_03_Guardian.ogg","PassiveTreeImage":"Art/2DArt/BaseClassIllustrations/GuardianAscendency.dds","@unknown:9":-1418,"@unknown:10":-1781,"BackgroundImage":"Art/2DArt/UIImages/InGame/Classes/StrInt/Guardian/PassiveSkillScreenBackground","LeagueName":"Polytheist","LeagueFlavourText":"Surely one of them\r\nhas the right answers?","LeagueBackgroundImage":"Art/2DArt/UIImages/InGame/Classes/CustomAscendancy/PassiveSkillScreenBackground","LeaguePassiveTreeImage":"Art/2DArt/BaseClassIllustrations/StrInt.dds","@unknown:16":0,"@unknown:17":0,"LeagueIcon":"Art/2DArt/UIImages/Common/IconStrIntAscendancy3","@unknown:19":false}},{"key":"Assassin","rowIndex":15,"fields":{"Id":"Assassin","ClassNo":1,"Character":{"kind":"ref","table":"Characters","key":"Metadata/Characters/DexInt/DexInt","rowIndex":5},"CoordinateRect":"650,845,976,429","RGBFlavourTextColour":"114,129,141","Name":"Assassin","FlavourText":"Death is a banquet. \r\n It's up to the murderer \r\n to write the menu.","OGGFile":"Audio/Dialogue/NPC/Izaro/Iz_18_AscClass_04_Shadow_01_Assassin.ogg","PassiveTreeImage":"Art/2DArt/BaseClassIllustrations/AssassinAscendency.dds","@unknown:9":-1760,"@unknown:10":-1822,"BackgroundImage":"Art/2DArt/UIImages/InGame/Classes/DexInt/Assassin/PassiveSkillScreenBackground","LeagueName":"Servant of Arakaali","LeagueFlavourText":"The Queen of Spiders\r\npreys upon mortals to\r\nfulfil her dark desires.","LeagueBackgroundImage":"Art/2DArt/UIImages/InGame/Classes/CustomAscendancy/PassiveSkillScreenBackground","LeaguePassiveTreeImage":"Art/2DArt/BaseClassIllustrations/DexInt.dds","@unknown:16":0,"@unknown:17":0,"LeagueIcon":"Art/2DArt/UIImages/Common/IconDexIntAscendancy1","@unknown:19":false}},{"key":"Trickster","rowIndex":16,"fields":{"Id":"Trickster","ClassNo":2,"Character":{"kind":"ref","table":"Characters","key":"Metadata/Characters/DexInt/DexInt","rowIndex":5},"CoordinateRect":"315,150,976,429","RGBFlavourTextColour":"114,129,141","Name":"Trickster","FlavourText":"  Everyone knows how to die. \r\n Some just need a little nudge \r\nto get them started.","OGGFile":"Audio/Dialogue/NPC/Izaro/Iz_18_AscClass_04_Shadow_02_Trickster.ogg","PassiveTreeImage":"Art/2DArt/BaseClassIllustrations/TricksterAscendency.dds","@unknown:9":-2040,"@unknown:10":-1672,"BackgroundImage":"Art/2DArt/UIImages/InGame/Classes/DexInt/Trickster/PassiveSkillScreenBackground","LeagueName":"Blind Prophet","LeagueFlavourText":"The sightless look to the\r\ndarkness for nourishment.","LeagueBackgroundImage":"Art/2DArt/UIImages/InGame/Classes/CustomAscendancy/PassiveSkillScreenBackground","LeaguePassiveTreeImage":"Art/2DArt/BaseClassIllustrations/DexInt.dds","@unknown:16":0,"@unknown:17":0,"LeagueIcon":"Art/2DArt/UIImages/Common/IconDexIntAscendancy2","@unknown:19":false}},{"key":"Saboteur","rowIndex":17,"fields":{"Id":"Saboteur","ClassNo":3,"Character":{"kind":"ref","table":"Characters","key":"Metadata/Characters/DexInt/DexInt","rowIndex":5},"CoordinateRect":"355,970,976,429","RGBFlavourTextColour":"114,129,141","N